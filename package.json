{
  "name": "@yetu/eng-core",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "description": "Deterministischer Rechenkern der Ingenieur-Werkbank und der Ingenieur-Fachtools (Festigkeit, Ashby, ab 0.10.0 Modulregister für Fluid, Verbindungen, Dichtungen, Stabwerke). Single Point of Truth für Formeln.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "python3 verification/pruefung.py --check-ergebnis",
    "pruefstatus": "python3 verification/pruefung.py --write-ergebnis && tsx scripts/formelkatalog.ts && tsx scripts/katalog-publish.ts",
    "katalog:publish": "tsx scripts/katalog-publish.ts",
    "golden": "python3 verification/pruefung.py --write-golden",
    "sync": "node scripts/sync-to-app.mjs",
    "data:pull": "node scripts/pull-data.mjs",
    "data:check": "node scripts/pull-data.mjs --check",
    "katalog": "tsx scripts/formelkatalog.ts",
    "freigabe:export": "python3 scripts/formelfreigabe.py export",
    "freigabe:import": "python3 scripts/formelfreigabe.py import",
    "data:pull:fd": "node scripts/pull-data.mjs --fd",
    "data:check:fd": "node scripts/pull-data.mjs --fd --check"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
